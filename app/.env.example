# Chain
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key-here

# Deployed contract addresses (from `forge script script/Deploy.s.sol --broadcast`)
NEXT_PUBLIC_AGRI_TOKEN_ADDRESS=
NEXT_PUBLIC_BATCH_REGISTRY_ADDRESS=
NEXT_PUBLIC_FAIR_PRICE_ORACLE_ADDRESS=
NEXT_PUBLIC_WEIGHBRIDGE_REGISTRY_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_FORWARDER_ADDRESS=

# Database — Neon Postgres, pooled connection string (@neondatabase/serverless)
DATABASE_URL=postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/agrichain?sslmode=require

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Relayer (sponsors farmer gas through Forwarder — testnet funds only)
RELAYER_PRIVATE_KEY=0x...

# 32-byte hex key (64 hex chars) for AES-256-GCM encryption of farmer custodial keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CUSTODY_MASTER_KEY=

# Indexer: block to start backfilling from if no cursor exists yet (0 = genesis, slow — prefer
# the deployment block from `forge script script/Deploy.s.sol` output)
INDEXER_START_BLOCK=0

# Weighbridge device signing (simulator only — never the same key as the app/relayer)
WEIGHBRIDGE_DEVICE_PRIVATE_KEY=0x...

# IPFS
PINATA_JWT=

# Oracle feed (backend job that calls FairPriceOracle.setDailyPrice)
ORACLE_FEED_PRIVATE_KEY=0x...
